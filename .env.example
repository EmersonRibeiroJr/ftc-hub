# Banco de dados (SQLite por padrão; para PostgreSQL veja o README)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar a sessão. Gere um com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Fuso horário usado para "hoje" e para formatar datas
NEXT_PUBLIC_TIMEZONE="America/Sao_Paulo"
