generator client {
  provider = "prisma-client-js"
}

// Para PostgreSQL: troque provider por "postgresql" e use uma URL postgres:// em DATABASE_URL.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Configurações da equipe (registro único, id = "team")
model Team {
  id           String  @id @default("team")
  name         String  @default("Minha Equipe FTC")
  number       String  @default("")
  season       String  @default("Temporada 2026–27")
  goal         String  @default("")
  sprint       String  @default("Sprint 1")
  robotVersion String  @default("v1.0")
  logoUrl      String?
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("EDITOR") // ADMIN | EDITOR | VIEWER
  title         String   @default("")
  specialty     String   @default("")
  level         String   @default("BEGINNER")
  trainingHours Float    @default(0)
  avatarUrl     String   @default("")
  projects      String   @default("") // separados por vírgula
  achievements  String   @default("") // separadas por vírgula
  createdAt     DateTime @default(now())

  tasks    Task[]        @relation("Assignee")
  comments Comment[]
  meetings Meeting[]
  systems  RobotSystem[]
  logs     ActivityLog[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  season      String   @default("")
  sprint      String   @default("Sprint 1")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  tasks       Task[]
}

model Competition {
  id       String   @id @default(cuid())
  name     String
  date     DateTime
  location String   @default("")
  tasks    Task[]
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String    @default("")
  area          String    @default("MECHANICS")
  status        String    @default("BACKLOG")
  priority      String    @default("MEDIUM")
  dueDate       DateTime?
  sprint        String    @default("Sprint 1")
  label         String    @default("")
  position      Int       @default(0)
  assigneeId    String?
  assignee      User?     @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  checklist     ChecklistItem[]
  comments      Comment[]
  attachments   Attachment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
}

model ChecklistItem {
  id       String  @id @default(cuid())
  text     String
  done     Boolean @default(false)
  position Int     @default(0)
  taskId   String?
  task     Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepId   String?
  step     EngineeringStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("FILE") // DOCUMENT | IMAGE | VIDEO | FILE
  path      String   @default("")     // arquivo enviado (pasta uploads/)
  url       String   @default("")     // ou link externo
  mime      String   @default("")
  size      Int      @default(0)
  createdAt DateTime @default(now())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepId    String?
  step      EngineeringStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

// Histórico de alterações (tarefas, etapas etc.)
model ActivityLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  message   String
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

model RobotSystem {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("HARDWARE") // HARDWARE (robô) | SOFTWARE (programação)
  version   String   @default("v0.1")
  status    String   @default("PLANNED")
  progress  Int      @default(0)
  commits   Int      @default(0)
  cadUrl    String   @default("")
  githubUrl String   @default("")
  docsUrl   String   @default("")
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
  tests     Test[]
}

model Test {
  id          String      @id @default(cuid())
  date        DateTime
  systemId    String
  system      RobotSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  version     String      @default("")
  result      String      @default("PASSED")
  durationSec Float       @default(0)
  videoUrl    String      @default("")
  notes       String      @default("")
}

model Meeting {
  id        String   @id @default(cuid())
  date      DateTime
  summary   String
  pending   String   @default("")
  attendees User[]
}

model Outreach {
  id           String   @id @default(cuid())
  event        String
  city         String   @default("")
  date         DateTime
  participants Int      @default(0)
  photos       Int      @default(0)
  impact       String   @default("")
  hours        Float    @default(0)
  sdgs         String   @default("") // números dos ODS separados por vírgula
}

model Sponsor {
  id        String    @id @default(cuid())
  company   String
  contact   String    @default("")
  stage     String    @default("PROSPECT")
  amount    Float     @default(0)
  notes     String    @default("")
  contactAt DateTime?
  renewalAt DateTime?
}

model Inventory {
  id          String @id @default(cuid())
  category    String @default("Geral")
  name        String
  quantity    Int    @default(0)
  minQuantity Int    @default(1)
  supplier    String @default("")
  price       Float  @default(0)
  location    String @default("")
  code        String @default("")
  imageUrl    String @default("")
}

model CalendarEvent {
  id    String   @id @default(cuid())
  title String
  type  String   @default("TRAINING")
  date  DateTime
  time  String   @default("")
  notes String   @default("")
}

model EngineeringStep {
  id          String @id @default(cuid())
  order       Int
  name        String
  description String @default("")
  status      String @default("TODO")
  notes       String @default("")
  checklist   ChecklistItem[]
  attachments Attachment[]
}

model Portfolio {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  icon    String  @default("📄")
  order   Int     @default(0)
  content String  @default("")
  done    Boolean @default(false)
}
